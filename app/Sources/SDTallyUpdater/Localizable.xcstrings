        }
      }
    },
    "O DMG não abriu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The DMG did not open."
          }
        }
      }
    },
    "O SDTally instalado continua como estava." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed SDTally is unchanged."
