    "Clique em Instalar para atualizar. Nada é instalado sem o seu clique." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على تثبيت للتحديث. لا يُثبَّت شيء قبل نقرك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes clic a Instal·la per actualitzar. No s’instal·la res sense el teu clic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na Nainstalovat aktualizujete. Nic se nenainstaluje bez vašeho kliknutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på Installér for at opdatere. Intet installeres uden dit klik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf Installieren, um zu aktualisieren. Ohne deinen Klick wird nichts installiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ στην Εγκατάσταση για ενημέρωση. Τίποτα δεν εγκαθίσταται χωρίς το κλικ σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Install to update. Nothing is installed until you click."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Instalar para actualizar. No se instala nada sin tu clic."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Instalar para actualizar. No se instala nada sin tu clic."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä napsauttamalla Asenna. Mitään ei asenneta ilman napsautustasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Installer pour mettre à jour. Rien n’est installé sans votre clic."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ על התקן כדי לעדכן. שום דבר לא מותקן בלי הלחיצה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट करने के लिए इंस्टॉल करें पर क्लिक करें। आपके क्लिक के बिना कुछ भी इंस्टॉल नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite Instaliraj za ažuriranje. Ništa se ne instalira bez vašeg klika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítéshez kattintson a Telepítés gombra. Kattintása nélkül semmi sem települ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik Instal untuk memperbarui. Tidak ada yang diinstal tanpa klik Anda."
          }
        },
        "it" : {
          "stringUnit" : {
