{
  "sourceLanguage" : "pt-BR",
  "strings" : {
    "A assinatura do app novo não é a do SDTally." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new app is not signed as SDTally."
          }
        }
      }
    },
    "A versão no DMG não é mais nova que a instalada." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The version in the DMG is not newer than the installed one."
          }
        }
      }
    },
    "Clique em Instalar para atualizar. Nada é instalado sem o seu clique." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Install to update. Nothing is installed until you click."
          }
        }
      }
    },
    "Depois" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later"
          }
        }
      }
    },
    "Feche o SDTally para terminar de instalar a versão %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close SDTally to finish installing version %@."
          }
        }
      }
    },
