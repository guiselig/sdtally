    "Deixa o SDTally ler pastas que o macOS esconde até do administrador, como Mail, Mensagens e Safari." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets SDTally read folders macOS hides even from the administrator, like Mail, Messages, and Safari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette a SDTally di leggere cartelle che macOS nasconde persino all’amministratore, come Mail, Messaggi e Safari."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє SDTally читати папки, які macOS ховає навіть від адміністратора, як-от Пошта, Повідомлення та Safari."
          }
