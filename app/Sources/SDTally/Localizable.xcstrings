    "Cópias do disco que o Time Machine guarda no próprio Mac; o macOS apaga sozinho quando falta espaço." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies of the disk that Time Machine keeps on the Mac itself; macOS deletes them on its own when space runs low."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie del disco che Time Machine conserva sul Mac stesso; macOS le elimina da solo quando manca spazio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копії диска, які Time Machine зберігає на самому Mac; macOS сама видаляє їх, коли бракує місця."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии диска, которые Time Machine хранит на самом Mac; macOS удаляет их сам, когда не хватает места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopior av disken som Time Machine sparar på själva Macen; macOS raderar dem själv när utrymmet tar slut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier af disken, som Time Machine gemmer på selve Mac'en; macOS sletter dem af sig selv, når der mangler plads."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier av disken som Time Machine lagrer på selve Mac-en; macOS sletter dem selv når det mangler plass."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine 保存在 Mac 本機上的磁碟副本；空間不足時，macOS 會自行刪除。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópias do disco que o Time Machine guarda no próprio Mac; o macOS elimina-as sozinho quando falta espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine 保存在 Mac 本机的磁盘副本；空间不足时 macOS 会自动删除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machineが対象のMac上に保存するディスクのコピーです。空き容量が足りなくなると、macOSが自動で削除します。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie disku, které Time Machine uchovává přímo na Macu; macOS je samo smaže, když dochází místo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Machine이 Mac 안에 보관하는 디스크 사본입니다. 공간이 부족하면 macOS가 자동으로 삭제합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ من القرص يحتفظ بها Time Machine على Mac نفسه؛ ويحذفها macOS تلقائيًا عند نقص المساحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còpies del disc que Time Machine desa al mateix Mac; macOS les elimina tot sol quan falta espai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien der Festplatte, die Time Machine auf dem Mac selbst aufbewahrt; macOS löscht sie von selbst, wenn der Platz knapp wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντίγραφα του δίσκου που το Time Machine κρατά στο ίδιο το Mac· το macOS τα διαγράφει μόνο του όταν λείπει χώρος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levyn kopioita, joita Time Machine säilyttää Macissa itsessään; macOS poistaa ne itse, kun tila loppuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies du disque que Time Machine conserve sur le Mac ; macOS les supprime de lui-même quand l’espace manque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עותקים של הכונן ש-Time Machine שומר ב-Mac עצמו; macOS מוחק אותם בעצמו כשחסר מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क की वे कॉपियाँ जो Time Machine Mac पर ही रखता है; जगह कम पड़ने पर macOS अपने-आप हटा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije diska koje Time Machine čuva na samom Macu; macOS ih sam briše kad ponestane prostora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan disk yang disimpan Time Machine di Mac itu sendiri; macOS menghapusnya sendiri saat ruang kurang."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan cakera yang disimpan Time Machine pada Mac itu sendiri; macOS memadamnya sendiri apabila ruang kurang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie dysku, które Time Machine przechowuje na samym Macu; macOS usuwa je sam, gdy brakuje miejsca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copii ale discului pe care Time Machine le păstrează chiar pe Mac; macOS le șterge singur când lipsește spațiul."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kópie disku, ktoré Time Machine uchováva priamo v Macu; macOS ich vymaže sám, keď dochádza miesto."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopije diska, ki jih Time Machine hrani na samem Macu; macOS jih sam izbriše, ko zmanjka prostora."
          }
        },
        "tr" : {
