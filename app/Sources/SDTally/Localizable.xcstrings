            "value" : "Thư mục hệ thống chỉ mở được bằng mật khẩu quản trị viên hoặc Root không mật khẩu; nếu không, phần không mở được sẽ bị macOS chặn."
          }
        },
        "es" : {
          "stringUnit" : {
