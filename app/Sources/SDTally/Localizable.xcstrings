        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øyeblikksbilde laget av en annen app, for eksempel for sikkerhetskopi eller kloning. Administrer det via appen som opprettet det."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
