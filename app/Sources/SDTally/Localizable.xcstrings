    "Nunca apaga nem altera arquivos, sem rede e sem telemetria." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never deletes or changes files, with no network and no telemetry."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non elimina né modifica mai i file, senza rete e senza telemetria."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніколи не видаляє й не змінює файли, без мережі й без телеметрії."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не удаляет и не изменяет, без сети и телеметрии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar eller ändrar aldrig filer, utan nätverk och utan telemetri."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter eller ændrer aldrig filer, uden netværk og uden telemetri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter eller endrer aldri filer, uten nettverk og uten telemetri."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不刪除或修改檔案，不連網，也沒有遙測。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca elimina nem altera ficheiros, sem rede e sem telemetria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从不删除或修改文件，不联网，也没有遥测。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを削除・変更することはなく、ネットワークも使わず、テレメトリもありません。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdy nic nemaže ani nemění, bez sítě a bez telemetrie."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 삭제하거나 변경하지 않으며, 네트워크와 원격 측정을 사용하지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحذف الملفات ولا يعدّلها أبدًا، بلا شبكة وبلا بيانات استخدام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai no elimina ni modifica fitxers, sense xarxa i sense telemetria."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht oder ändert nie Dateien, ohne Netzwerk und ohne Telemetrie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν διαγράφει ούτε αλλάζει ποτέ αρχεία, χωρίς δίκτυο και χωρίς τηλεμετρία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei koskaan poista tai muuta tiedostoja, ei verkkoa eikä telemetriaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne supprime ni ne modifie jamais de fichiers, sans réseau ni télémétrie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף פעם לא מוחק ולא משנה קבצים, ללא רשת וללא טלמטריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें न कभी हटाता है, न बदलता है; कोई नेटवर्क नहीं, कोई टेलीमेट्री नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikad ne briše niti mijenja datoteke, bez mreže i bez telemetrije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak pernah menghapus atau mengubah file, tanpa jaringan dan tanpa telemetri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak pernah memadam atau mengubah fail, tanpa rangkaian dan tanpa telemetri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie usuwa ani nie zmienia plików, bez sieci i bez telemetrii."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu șterge și nu modifică niciodată fișiere, fără rețea și fără telemetrie."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdy nemaže ani nemení súbory, bez siete a bez telemetrie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikoli ne izbriše ali spremeni datotek, brez omrežja in brez telemetrije."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları asla silmez veya değiştirmez; ağ yok, telemetri yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không bao giờ xóa hay thay đổi tệp, không dùng mạng và không có telemetry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca elimina ni modifica archivos, sin red y sin telemetría."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert of wijzigt nooit bestanden, geen netwerk en geen telemetrie."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ลบหรือแก้ไขไฟล์ ไม่ใช้เครือข่าย และไม่มีการเก็บข้อมูลการใช้งาน"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soha nem töröl és nem módosít fájlokat, nincs hálózat és nincs telemetria."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca elimina ni modifica archivos, sin red y sin telemetría."
          }
        }
      }
    },
