    "Ficam dentro de Dados do Sistema e o macOS gerencia o tamanho. Não apague a pasta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They live inside System Data and macOS manages the size. Don't delete the folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trovano dentro Dati sistema e macOS ne gestisce la dimensione. Non eliminare la cartella."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони входять до Системних даних, а розмір контролює macOS. Не видаляйте папку."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находятся внутри «Системных данных», размером управляет macOS. Не удаляйте папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De finns i Systemdata och macOS hanterar storleken. Radera inte mappen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ligger i Systemdata, og macOS styrer størrelsen. Slet ikke mappen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ligger i Systemdata, og macOS styrer størrelsen. Ikke slett mappen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
