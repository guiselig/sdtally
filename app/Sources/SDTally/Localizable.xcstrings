    "Mede como administrador pelo Root sem Senha, sem pedir a senha." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures as administrator through Passwordless Root, without asking for the password."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura come amministratore tramite Root senza password, senza chiedere la password."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимірює як адміністратор через Root без пароля, без запиту пароля."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет от администратора через Root без пароля, не запрашивая пароль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mäter som administratör via Lösenordsfri root, utan att fråga efter lösenord."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler som administrator via Root uden adgangskode, uden at bede om adgangskode."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler som administrator via Passordfri root, uten å be om passord."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過「免密碼 Root」以管理員身分測量，不需輸入密碼。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede como administrador pelo Root sem Palavra-passe, sem pedir a palavra-passe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过“免密码 Root”以管理员身份测量，无需输入密码。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードなしRoot経由で、パスワードを求めずに管理者として測定します。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měří jako správce přes Root bez hesla, bez dotazu na heslo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호를 묻지 않고 비밀번호 없는 Root로 관리자 권한 측정을 합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس كمسؤول عبر الجذر بلا كلمة مرور، بدون طلب كلمة السر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesura com a administrador mitjançant Root sense contrasenya, sense demanar la contrasenya."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst als Administrator über Root ohne Passwort, ohne nach dem Passwort zu fragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά ως διαχειριστής μέσω του Root χωρίς κωδικό, χωρίς να ζητά κωδικό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittaa ylläpitäjänä Salasanaton root -palvelun kautta kysymättä salasanaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure en tant qu’administrateur via Root sans mot de passe, sans demander le mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודד כמנהל דרך Root ללא סיסמה, בלי לבקש סיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना-पासवर्ड रूट से, पासवर्ड माँगे बिना एडमिन के रूप में मापता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
