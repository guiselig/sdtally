    "Se o SDTally fechar agora, a medição em andamento se perde e terá de começar de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أُغلق SDTally الآن، فسيضيع القياس الجاري وسيتعين البدء من جديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el SDTally es tanca ara, la mesura en curs es perd i caldrà començar de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se SDTally teď zavře, probíhající měření se ztratí a bude nutné začít znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis SDTally lukkes nu, går den igangværende måling tabt og skal startes forfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn SDTally jetzt beendet wird, geht die laufende Messung verloren und muss neu beginnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το SDTally κλείσει τώρα, η τρέχουσα μέτρηση χάνεται και θα πρέπει να ξεκινήσει από την αρχή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If SDTally quits now, the measurement in progress is lost and will have to start over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si SDTally se cierra ahora, la medición en curso se pierde y habrá que empezar de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si SDTally se cierra ahora, la medición en curso se pierde y habrá que empezar de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos SDTally suljetaan nyt, käynnissä oleva mittaus menetetään ja se on aloitettava alusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si SDTally se ferme maintenant, la mesure en cours est perdue et devra recommencer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם SDTally ייסגר עכשיו, המדידה שמתבצעת תאבד ויהיה צורך להתחיל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर SDTally अभी बंद होता है, तो चल रहा माप खो जाएगा और फिर से शुरू करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se SDTally sada zatvori, mjerenje u tijeku se gubi i morat će početi ispočetka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az SDTally most bezárul, a folyamatban lévő mérés elvész, és elölről kell kezdeni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika SDTally ditutup sekarang, pengukuran yang sedang berjalan akan hilang dan harus dimulai dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se SDTally si chiude ora, la misurazione in corso va persa e dovrà ricominciare da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今 SDTally を終了すると、実行中の計測は失われ、最初からやり直しになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 SDTally를 종료하면 진행 중인 측정이 사라지고 처음부터 다시 시작해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika SDTally ditutup sekarang, pengukuran yang sedang berjalan akan hilang dan perlu dimulakan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis SDTally avsluttes nå, går målingen som pågår tapt og må starte på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als SDTally nu stopt, gaat de lopende meting verloren en moet die opnieuw beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli SDTally zostanie teraz zamknięty, trwający pomiar przepadnie i trzeba będzie zacząć od nowa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o SDTally fechar agora, a medição em curso perde-se e terá de recomeçar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă SDTally se închide acum, măsurarea în desfășurare se pierde și va trebui reluată de la început."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если закрыть SDTally сейчас, текущее измерение пропадёт и его придётся начать заново."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa SDTally teraz zatvorí, prebiehajúce meranie sa stratí a bude treba začať odznova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se SDTally zdaj zapre, se merjenje, ki poteka, izgubi in bo treba začeti znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om SDTally avslutas nu går den pågående mätningen förlorad och måste börja om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากปิด SDTally ตอนนี้ การวัดที่กำลังดำเนินอยู่จะหายไปและต้องเริ่มใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDTally şimdi kapanırsa süren ölçüm kaybolur ve baştan başlaması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо закрити SDTally зараз, поточне вимірювання втратиться і його доведеться почати знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đóng SDTally bây giờ, phép đo đang chạy sẽ bị mất và phải bắt đầu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果现在退出 SDTally，正在进行的测量将会丢失，需要重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果現在結束 SDTally，正在進行的測量將會遺失，需要重新開始。"
          }
        }
      }
    },
