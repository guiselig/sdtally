    "Feche e abra de novo o %@. O espaço volta quando ele soltar os arquivos apagados." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit and reopen %@. The space comes back when it releases the deleted files."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi e riapri %@. Lo spazio torna quando rilascia i file eliminati."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрийте та знову відкрийте %@. Місце повернеться, коли воно відпустить видалені файли."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте и снова откройте %@. Место освободится, когда он отпустит удалённые файлы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng och öppna %@ igen. Utrymmet frigörs när den släpper de raderade filerna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk %@, og åbn den igen. Pladsen frigives, når den slipper de slettede filer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukk %@ og åpne det på nytt. Plassen kommer tilbake når det slipper de slettede filene."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請關閉 %@ 再重新開啟。它放開已刪除的檔案後，空間就會釋出。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche e volte a abrir o %@. O espaço volta quando ele libertar os ficheiros eliminados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请退出并重新打开 %@。它释放已删除的文件后，空间即收回。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を終了してもう一度開いてください。削除済みファイルが解放されると、容量が戻ります。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřete %@ a znovu ho otevřete. Místo se vrátí, až uvolní smazané soubory."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱을 닫았다가 다시 여세요. 앱이 삭제된 파일을 놓으면 공간이 돌아옵니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق %@ وافتحه من جديد. تعود المساحة عندما يترك الملفات المحذوفة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanca i torna a obrir %@. L’espai torna quan deixi anar els fitxers eliminats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende %@ und starte die App neu. Der Platz wird frei, sobald die App die gelöschten Dateien freigibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε και ανοίξτε ξανά το %@. Ο χώρος επιστρέφει όταν αφήσει τα διαγραμμένα αρχεία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje %@ ja avaa se uudelleen. Tila vapautuu, kun se päästää irti poistetuista tiedostoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez puis rouvrez %@. L’espace est libéré quand l’app relâche les fichiers supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור ופתח שוב את %@. השטח חוזר כשהוא משחרר את הקבצים שנמחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को बंद करके दोबारा खोलें। जैसे ही वह हटाई गई फ़ाइलें छोड़ेगा, जगह वापस मिल जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorite pa ponovno otvorite %@. Prostor se vraća kad pusti izbrisane datoteke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup dan buka lagi %@. Ruang kembali saat file yang sudah dihapus dilepaskan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup dan buka semula %@. Ruang kembali apabila ia melepaskan fail yang dipadam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknij i otwórz ponownie: %@. Miejsce wraca, gdy zwolni usunięte pliki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Închideți și redeschideți %@. Spațiul revine când eliberează fișierele șterse."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorte %@ a otvorte ho znova. Miesto sa uvoľní, keď pustí odstránené súbory."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaprite %@ in ga znova odprite. Prostor se vrne, ko izpusti izbrisane datoteke."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını kapatıp yeniden açın. Silinmiş dosyaları bıraktığında alan geri gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng rồi mở lại %@. Dung lượng được trả lại khi nó nhả các tệp đã xóa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra y vuelve a abrir %@. El espacio se recupera cuando suelte los archivos eliminados."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit %@ en open het opnieuw. De ruimte komt vrij zodra het de verwijderde bestanden loslaat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดแล้วเปิด %@ ใหม่ พื้นที่จะคืนเมื่อปล่อยไฟล์ที่ลบแล้ว"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zárja be, majd nyissa meg újra: %@. A hely akkor szabadul fel, amikor elengedi a törölt fájlokat."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra y vuelve a abrir %@. El espacio se recupera cuando suelte los archivos eliminados."
          }
        }
      }
    },
    "Feche o app Claude antes: é a máquina virtual dele, e mexer com ela em uso a corrompe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit the Claude app first: it's its virtual machine, and touching it while in use corrupts it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi prima l’app Claude: è la sua macchina virtuale, e toccarla mentre è in uso la corrompe."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу закрийте програму Claude: це її віртуальна машина, і втручання під час використання її пошкодить."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала закройте приложение Claude: это его виртуальная машина, и работа с ней во время использования её повреждает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng appen Claude först: det är dess virtuella maskin, och att röra den medan den används skadar den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk Claude-appen først: det er dens virtuelle maskine, og at pille ved den under brug ødelægger den."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukk Claude-appen først: det er appens virtuelle maskin, og å røre den mens den er i bruk ødelegger den."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先關閉 Claude App：這是它的虛擬機器，使用中動它會導致損毀。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche primeiro a app Claude: é a máquina virtual dela, e mexer nela em uso corrompe-a."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先退出 Claude App：这是它的虚拟机，使用中改动会损坏它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にClaudeアプリを終了してください。これはClaudeの仮想マシンで、使用中に触ると壊れます。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív zavřete aplikaci Claude: je to její virtuální stroj a zásah za běhu ho poškodí."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 Claude 앱을 종료하세요. 앱의 가상 머신이라 사용 중에 건드리면 손상됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق تطبيق Claude أولًا: فهذا جهازه الافتراضي، والعبث به أثناء الاستخدام يُتلفه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanca abans l’app Claude: és la seva màquina virtual, i tocar-la mentre s’utilitza la corromp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe zuerst die Claude-App: Es ist ihre virtuelle Maschine, und Eingriffe während der Nutzung beschädigen sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε πρώτα την εφαρμογή Claude: είναι η εικονική της μηχανή και η επέμβαση ενώ χρησιμοποιείται την καταστρέφει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje ensin Claude-appi: se on sen virtuaalikone, ja sen käsittely käytön aikana rikkoo sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez d’abord l’app Claude : c’est sa machine virtuelle, et y toucher pendant qu’elle est utilisée la corrompt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור קודם את היישום Claude: זו המכונה הווירטואלית שלו, ושינוי שלה בזמן שהיא בשימוש משחית אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले Claude ऐप बंद करें: यह उसकी वर्चुअल मशीन है और इस्तेमाल के दौरान छेड़ने से वह खराब हो जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo zatvorite aplikaciju Claude: to je njezin virtualni stroj, a diranje dok je u uporabi oštećuje ga."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup aplikasi Claude dulu: itu mesin virtualnya, dan mengutak-atiknya saat sedang dipakai merusaknya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup aplikasi Claude dahulu: ini mesin mayanya, dan mengusiknya semasa digunakan akan merosakkannya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zamknij aplikację Claude: to jej maszyna wirtualna, a ruszanie jej w trakcie użycia ją uszkadza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Închideți mai întâi aplicația Claude: este mașina ei virtuală, iar modificarea ei în timpul utilizării o corupe."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv zatvorte aplikáciu Claude: je to jej virtuálny stroj a zásah počas používania ho poškodí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prej zaprite aplikacijo Claude: to je njen navidezni stroj, poseganje vanj med uporabo pa ga pokvari."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Claude uygulamasını kapatın: bu onun sanal makinesidir ve kullanımdayken dokunmak onu bozar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đóng ứng dụng Claude trước: đó là máy ảo của nó, và động vào khi đang dùng sẽ làm hỏng nó."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
