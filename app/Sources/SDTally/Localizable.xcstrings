            "value" : "ทำให้ไอคอนในแถบเมนูพร้อมหลังเปิด Mac โดยไม่ต้องเปิดหน้าต่าง ปรากฏในรายการเข้าสู่ระบบ"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
