          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכין את הסמל בשורת התפריטים אחרי הפעלת ה-Mac, בלי לפתוח את החלון. מופיע ב“פריטי התחברות”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac चालू होने के बाद विंडो खोले बिना मेनू बार का आइकॉन तैयार रखता है। लॉगिन आइटम में दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
