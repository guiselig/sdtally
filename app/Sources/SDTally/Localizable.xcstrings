          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémové priečinky sa otvoria iba s heslom správcu alebo funkciou Root bez hesla; bez nich zostane neotvorené blokované systémom macOS."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemske mape se odprejo samo z geslom skrbnika ali z Root brez gesla; sicer neodprto ostane blokirano z macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem klasörleri yalnızca yönetici parolasıyla veya Parolasız Root ile açılır; bunlar olmadan açılamayanlar macOS tarafından engellenmiş kalır."
          }
