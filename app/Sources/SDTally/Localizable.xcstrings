        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zabraknie miejsca, macOS może ją usunąć; następna kopia zapasowa trwa dłużej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă lipsește spațiul, macOS îl poate șterge; următorul backup durează mai mult."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak dochádza miesto, macOS ju môže vymazať; ďalšia záloha potom trvá dlhšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
