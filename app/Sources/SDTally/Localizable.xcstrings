    "Memória que foi parar no disco. Fechar apps pesados ou reiniciar devolve o espaço." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory that ended up on disk. Quitting heavy apps or restarting gives the space back."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria finita sul disco. Chiudere le app pesanti o riavviare restituisce lo spazio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пам’ять, яка потрапила на диск. Закриття важких програм або перезапуск повертає місце."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Память, оказавшаяся на диске. Закрытие тяжёлых приложений или перезагрузка возвращает место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minne som hamnade på disken. Stäng tunga appar eller starta om för att få tillbaka utrymmet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukommelse, der er endt på disken. Pladsen frigives, når du lukker tunge apps eller genstarter."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minne som havnet på disken. Å lukke tunge apper eller starte på nytt gir plassen tilbake."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫到磁碟上的記憶體。關閉吃資源的 App 或重新啟動即可釋出空間。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória que foi parar ao disco. Fechar apps pesadas ou reiniciar devolve o espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已写入磁盘的内存。退出占用较大的 App 或重新启动可收回空间。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクに書き出されたメモリです。負荷の高いアプリを終了するか再起動すると、領域が戻ります。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paměť, která skončila na disku. Zavřením náročných aplikací nebo restartem se místo vrátí."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크로 옮겨진 메모리입니다. 무거운 앱을 닫거나 재시동하면 공간이 돌아옵니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرة انتهى بها المطاف على القرص. إغلاق التطبيقات الثقيلة أو إعادة التشغيل يعيد المساحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memòria que ha anat a parar al disc. Tancar apps pesades o reiniciar en retorna l’espai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf die Festplatte ausgelagerter Arbeitsspeicher. Das Schließen großer Apps oder ein Neustart gibt den Platz wieder frei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μνήμη που κατέληξε στον δίσκο. Αν κλείσετε βαριές εφαρμογές ή κάνετε επανεκκίνηση, ο χώρος επιστρέφει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levylle siirtynyttä muistia. Raskaiden appien sulkeminen tai uudelleenkäynnistys vapauttaa tilan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire déplacée vers le disque. Quitter les apps lourdes ou redémarrer libère l’espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זיכרון שהועבר לכונן. סגירת יישומים כבדים או הפעלה מחדש מחזירות את השטח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेमोरी का वह हिस्सा जो डिस्क पर चला गया। भारी ऐप बंद करने या रीस्टार्ट करने से जगह वापस मिल जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorija koja je završila na disku. Zatvaranjem zahtjevnih aplikacija ili ponovnim pokretanjem prostor se vraća."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memori yang berpindah ke disk. Menutup aplikasi berat atau memulai ulang mengembalikan ruangnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memori yang berpindah ke cakera. Menutup aplikasi yang berat atau memulakan semula Mac akan memulangkan ruang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć, która trafiła na dysk. Zamknięcie ciężkich aplikacji lub ponowne uruchomienie zwalnia miejsce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorie ajunsă pe disc. Închiderea aplicațiilor grele sau repornirea eliberează spațiul."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamäť, ktorá skončila na disku. Zatvorením náročných aplikácií alebo reštartom sa miesto uvoľní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomnilnik, ki je končal na disku. Zapiranje težkih aplikacij ali ponovni zagon vrne prostor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diske taşınan bellek. Ağır uygulamaları kapatmak veya yeniden başlatmak alanı geri verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ bị đẩy ra ổ đĩa. Đóng các ứng dụng nặng hoặc khởi động lại sẽ trả lại dung lượng."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria que ha ido a parar al disco. Cerrar apps pesadas o reiniciar recupera el espacio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheugen dat naar de schijf is verplaatst. Zware apps sluiten of de Mac opnieuw opstarten geeft de ruimte vrij."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน่วยความจำที่ถูกย้ายไปไว้ในดิสก์ การปิดแอปที่ใช้ทรัพยากรมากหรือรีสตาร์ทจะคืนพื้นที่"
