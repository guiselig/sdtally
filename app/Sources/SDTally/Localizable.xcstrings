          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenen des Benchmarks, die beim nächsten Lauf neu geladen werden: im Finder in den Papierkorb legen. Der Platz wird frei, sobald der Papierkorb geleert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σκηνές του benchmark, που κατεβαίνουν ξανά όταν εκτελείται: μετακινήστε τις στον Κάδο απορριμμάτων από το Finder. Ο χώρος επιστρέφει όταν αδειάσει ο Κάδος απορριμμάτων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benchmarkin kohtauksia, jotka latautuvat uudelleen sen ajettaessa: siirrä roskakoriin Finderissa. Tila vapautuu, kun roskakori tyhjennetään."
          }
        },
        "fr" : {
          "stringUnit" : {
