    "Vale a data em que cada item entrou no Lixo, não a de modificação; só o Lixo desta conta no volume Data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The date each item entered the Trash counts, not the modification date; only this account's Trash on the Data volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta la data in cui ogni elemento è entrato nel Cestino, non quella di modifica; solo il Cestino di questo account nel volume Data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Враховується дата, коли кожен елемент потрапив до Кошика, а не дата зміни; лише Кошик цього облікового запису на томі Data."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывается дата, когда элемент попал в Корзину, а не дата изменения; только Корзина этой учётной записи на томе Data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som räknas är datumet då varje objekt hamnade i papperskorgen, inte ändringsdatumet; endast papperskorgen för det här kontot på Data-volymen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er datoen for, hvornår hvert emne kom i papirkurven, der tæller, ikke ændringsdatoen; kun papirkurven for denne konto på diskenheden Data."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som teller er datoen hvert objekt havnet i papirkurven, ikke endringsdatoen; bare papirkurven til denne kontoen på Data-volumet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以每個項目放入垃圾桶的日期為準，不是修改日期；僅限資料卷宗上此帳號的垃圾桶。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta a data em que cada item entrou no Lixo, não a de modificação; só o Lixo desta conta no volume Data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以每个项目移入废纸篓的日期为准，而不是修改日期；仅限 Data 宗卷上本账户的废纸篓。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目がゴミ箱に入った日付で判定します（変更日ではありません）。Dataボリューム上のこのアカウントのゴミ箱のみが対象です。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí datum, kdy položka přišla do Koše, ne datum změny; jen Koš tohoto účtu na svazku Data."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목이 휴지통에 들어간 날짜 기준이며 수정 날짜가 아닙니다. Data 볼륨에 있는 이 계정의 휴지통만 해당합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعتبر هو تاريخ دخول كل عنصر إلى سلة المهملات وليس تاريخ تعديله؛ وتُقاس فقط سلة مهملات هذا الحساب في وحدة التخزين Data."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compta la data en què cada element va entrar a la paperera, no la de modificació; només la paperera d’aquest compte al volum Data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es zählt das Datum, an dem jedes Objekt in den Papierkorb kam, nicht das Änderungsdatum; nur der Papierkorb dieses Benutzers auf dem Data-Volume."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράει η ημερομηνία που κάθε στοιχείο μπήκε στον Κάδο απορριμμάτων, όχι η ημερομηνία τροποποίησης· μόνο ο Κάδος απορριμμάτων αυτού του λογαριασμού στον τόμο Data."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratkaisee päivä, jolloin kohde joutui roskakoriin, ei muokkauspäivä; vain tämän tilin roskakori Data-taltiolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte la date d’entrée de chaque élément dans la Corbeille, pas celle de modification ; uniquement la Corbeille de ce compte sur le volume Data."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נחשב התאריך שבו כל פריט נכנס לאשפה, לא תאריך השינוי; רק האשפה של חשבון זה בכרך Data."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम के ट्रैश में आने की तारीख़ गिनी जाती है, बदलाव की नहीं; सिर्फ़ Data वॉल्यूम पर इस खाते का ट्रैश।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi datum kad je svaka stavka stavljena u Smeće, a ne datum izmjene; samo Smeće ovog računa na jedinici Data."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang berlaku adalah tanggal tiap item masuk ke Sampah, bukan tanggal modifikasi; hanya Sampah akun ini di volume Data."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarikh yang diambil kira ialah tarikh setiap item masuk ke Tong Sampah, bukan tarikh ubah suai; hanya Tong Sampah akaun ini pada volum Data."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się data, w której każdy element trafił do Kosza, a nie data modyfikacji; tylko Kosz tego konta na woluminie Data."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contează data la care fiecare element a intrat în Coș de gunoi, nu data modificării; doar Coșul de gunoi al acestui cont, din volumul Data."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí dátum, kedy sa každá položka dostala do Koša, nie dátum zmeny; iba Kôš tohto účtu vo zväzku Data."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šteje datum, ko je bil posamezen element vržen v koš, ne datum spremembe; samo koš tega računa na nosilcu Data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklik tarihi değil, her öğenin Çöp Sepeti'ne girdiği tarih geçerlidir; yalnızca bu hesabın Data birimindeki Çöp Sepeti sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính theo ngày từng mục vào Thùng rác, không phải ngày sửa đổi; chỉ Thùng rác của tài khoản này trên volume Data."
          }
        },
        "es" : {
