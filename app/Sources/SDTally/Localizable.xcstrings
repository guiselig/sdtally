    "Esvazie o Lixo no Finder. O espaço volta quando o Lixo é esvaziado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty the Trash in Finder. The space comes back when the Trash is emptied."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svuota il Cestino nel Finder. Lo spazio torna quando il Cestino viene svuotato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистіть Кошик у Finder. Місце повернеться, коли Кошик буде очищено."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистите Корзину в Finder. Место освободится после очистки Корзины."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töm papperskorgen i Finder. Utrymmet frigörs när papperskorgen töms."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tøm papirkurven i Finder. Pladsen frigives, når papirkurven tømmes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tøm papirkurven i Finder. Plassen kommer tilbake når papirkurven er tømt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中清倒垃圾桶。垃圾桶清倒後，空間就會釋出。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esvazie o Lixo no Finder. O espaço volta quando o Lixo for esvaziado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在访达中清倒废纸篓。清倒后空间即收回。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderでゴミ箱を空にしてください。ゴミ箱を空にすると容量が戻ります。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysypte Koš ve Finderu. Místo se vrátí po vysypání Koše."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에서 휴지통을 비우세요. 휴지통을 비우면 공간이 돌아옵니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفرغ سلة المهملات من فايندر. تعود المساحة عند إفراغ سلة المهملات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buida la paperera des del Finder. L’espai torna quan la paperera es buida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere den Papierkorb im Finder. Der Platz wird frei, sobald der Papierkorb geleert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αδειάστε τον Κάδο απορριμμάτων στο Finder. Ο χώρος επιστρέφει όταν αδειάσει ο Κάδος απορριμμάτων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjennä roskakori Finderissa. Tila vapautuu, kun roskakori tyhjennetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videz la Corbeille dans le Finder. L’espace est libéré quand la Corbeille est vidée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוקן את האשפה ב-Finder. השטח חוזר כשהאשפה מתרוקנת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder में ट्रैश खाली करें। ट्रैश खाली करने पर जगह वापस मिलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispraznite Smeće u Finderu. Prostor se vraća kad se Smeće isprazni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan Sampah di Finder. Ruang kembali saat Sampah dikosongkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan Tong Sampah dalam Finder. Ruang kembali apabila Tong Sampah dikosongkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opróżnij Kosz w Finderze. Miejsce wraca po opróżnieniu Kosza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goliți Coșul de gunoi din Finder. Spațiul revine când Coșul de gunoi este golit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyprázdnite Kôš vo Finderi. Miesto sa uvoľní po vyprázdnení Koša."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izpraznite koš v Finderju. Prostor se vrne, ko je koš izpraznjen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder'da Çöp Sepeti'ni boşaltın. Çöp Sepeti boşaltılınca alan geri gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dọn Thùng rác trong Finder. Dung lượng được trả lại khi Thùng rác được dọn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la Papelera desde el Finder. El espacio vuelve cuando se vacía la Papelera."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeg de Prullenmand in de Finder. De ruimte komt vrij zodra de Prullenmand is geleegd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล้างถังขยะใน Finder พื้นที่จะคืนเมื่อล้างถังขยะแล้ว"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ürítse ki a Kukát a Finderben. A hely a Kuka kiürítésekor szabadul fel."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la Papelera desde el Finder. El espacio vuelve cuando se vacía la Papelera."
          }
        }
      }
