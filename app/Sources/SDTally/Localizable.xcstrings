        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengukur sebagai pentadbir melalui Root Tanpa Kata Laluan, tanpa meminta kata laluan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierzy jako administrator przez Root bez hasła, bez pytania o hasło."
          }
        },
        "ro" : {
          "stringUnit" : {
