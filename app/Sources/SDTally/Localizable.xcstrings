    "Sem o Acesso Total ao Disco, Mail, Mensagens, Safari e outras pastas protegidas ficam bloqueadas pelo macOS. Ative em Configurações (⌘,) e meça de novo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without Full Disk Access, Mail, Messages, Safari, and other protected folders stay blocked by macOS. Turn it on in Settings (⌘,) and measure again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Accesso completo al disco, Mail, Messaggi, Safari e altre cartelle protette restano bloccate da macOS. Attivalo in Impostazioni (⌘,) e misura di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Повного доступу до диска Пошта, Повідомлення, Safari та інші захищені папки заблоковані macOS. Увімкніть у Параметрах (⌘,) і виміряйте знову."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без доступа к диску Почта, Сообщения, Safari и другие защищённые папки заблокированы macOS. Включите в настройках SDTally (⌘,) и измерьте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan full skivtillgång blockerar macOS Mail, Meddelanden, Safari och andra skyddade mappar. Aktivera i Inställningar (⌘,) och mät igen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden Fuld adgang til disk er Mail, Beskeder, Safari og andre beskyttede mapper blokeret af macOS. Aktivér det i Indstillinger (⌘,), og mål igen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten full disktilgang blir Mail, Meldinger, Safari og andre beskyttede mapper blokkert av macOS. Slå på i Innstillinger (⌘,) og mål på nytt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有完全取用磁碟，郵件、訊息、Safari 與其他受保護的檔案夾會被 macOS 封鎖。請在「設定」（⌘,）中開啟，然後重新測量。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o Acesso completo ao disco, Mail, Mensagens, Safari e outras pastas protegidas ficam bloqueadas pelo macOS. Ative em Definições (⌘,) e meça de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有完全磁盘访问权限时，邮件、信息、Safari 浏览器和其他受保护的文件夹会被 macOS 阻止。请在设置（⌘,）中开启，然后重新测量。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスクアクセスがないと、メール、メッセージ、Safariなどの保護されたフォルダはmacOSによりブロックされます。設定（⌘,）でオンにして、もう一度測定してください。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Plného přístupu k disku jsou Mail, Zprávy, Safari a další chráněné složky blokované systémem macOS. Zapněte ho v Nastavení (⌘,) a změřte znovu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한이 없으면 Mail, 메시지, Safari 및 기타 보호된 폴더가 macOS에서 차단됩니다. 설정(⌘,)에서 켠 뒤 다시 측정하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون الوصول الكامل إلى القرص، تبقى البريد والرسائل وSafari ومجلدات محمية أخرى محظورة من macOS. فعّله في الإعدادات (⌘,) ثم قِس مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense l’Accés complet al disc, Mail, Missatges, Safari i altres carpetes protegides queden bloquejades per macOS. Activa’l a Configuració (⌘,) i torna a mesurar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Festplattenvollzugriff sind Mail, Nachrichten, Safari und andere geschützte Ordner von macOS gesperrt. Aktiviere ihn in den Einstellungen (⌘,) und miss erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς Πλήρη πρόσβαση στον δίσκο, το Mail, τα Μηνύματα, το Safari και άλλοι προστατευμένοι φάκελοι αποκλείονται από το macOS. Ενεργοποιήστε την στις Ρυθμίσεις (⌘,) και μετρήστε ξανά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman Koko levyn käyttöä macOS estää Mailin, Viestien, Safarin ja muiden suojattujen kansioiden luvun. Ota käyttöön kohdassa Asetukset (⌘,) ja mittaa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l’accès complet au disque, Mail, Messages, Safari et d’autres dossiers protégés restent bloqués par macOS. Activez-le dans Réglages (⌘,) puis mesurez à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי גישה מלאה לכונן, דואר, הודעות, Safari ותיקיות מוגנות אחרות חסומים על ידי macOS. הפעל בהגדרות (‎⌘,‎) ומדוד שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ण डिस्क ऐक्सेस के बिना मेल, संदेश, Safari और अन्य सुरक्षित फ़ोल्डर macOS द्वारा ब्लॉक रहते हैं। सेटिंग (⌘,) में चालू करें और दोबारा मापें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez punog pristupa disku macOS blokira Mail, Poruke, Safari i druge zaštićene mape. Uključite ga u Postavkama (⌘,) i ponovno izmjerite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa Akses Disk Penuh, Mail, Pesan, Safari, dan folder terlindungi lainnya diblokir oleh macOS. Aktifkan di Pengaturan (⌘,) lalu ukur lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa Akses Cakera Penuh, Mail, Mesej, Safari dan folder terlindung lain disekat oleh macOS. Dayakan dalam Seting (⌘,) dan ukur semula."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Pełnego dostępu do dysku Poczta, Wiadomości, Safari i inne chronione foldery są zablokowane przez macOS. Włącz w Ustawieniach SDTally (⌘,) i zmierz ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără Acces complet la disc, Mail, Mesaje, Safari și alte foldere protejate rămân blocate de macOS. Activați-l în Setări (⌘,) și măsurați din nou."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Plného prístupu k disku macOS blokuje Mail, Správy, Safari a ďalšie chránené priečinky. Zapnite ho v Nastaveniach (⌘,) a zmerajte znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brez polnega dostopa do diska macOS blokira Pošto, Sporočila, Safari in druge zaščitene mape. Vklopite ga v nastavitvah SDTally (⌘,) in izmerite znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Erişimi olmadan Mail, Mesajlar, Safari ve diğer korumalı klasörler macOS tarafından engellenir. Ayarlar'da (⌘,) etkinleştirin ve yeniden ölçün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có Quyền truy cập đầy đủ vào ổ đĩa, Mail, Tin nhắn, Safari và các thư mục được bảo vệ khác sẽ bị macOS chặn. Bật trong Cài đặt (⌘,) rồi đo lại."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso total al disco, Mail, Mensajes, Safari y otras carpetas protegidas quedan bloqueados por macOS. Actívalo en Ajustes (⌘,) y vuelve a medir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder Volledige schijftoegang blokkeert macOS Mail, Berichten, Safari en andere beschermde mappen. Schakel dit in bij Instellingen (⌘,) en meet opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีการเข้าถึงดิสก์ทั้งหมด Mail ข้อความ Safari และโฟลเดอร์ที่ได้รับการป้องกันอื่นๆ จะถูก macOS บล็อก ให้เปิดใช้ในการตั้งค่า (⌘,) แล้ววัดอีกครั้ง"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes hozzáférés a lemezhez nélkül a Mail, az Üzenetek, a Safari és más védett mappák le vannak tiltva a macOS által. Kapcsolja be a Beállításokban (⌘,), majd mérjen újra."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso completo al disco, Mail, Mensajes, Safari y otras carpetas protegidas quedan bloqueados por macOS. Actívalo en Configuración (⌘,) y vuelve a medir."
          }
        }
      }
    },
