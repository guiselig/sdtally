    "Notifica quando o disco cresce 10 GB em um dia ou fica com menos de 10 % livre. Sem ela, o aviso aparece só no ícone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifies you when the disk grows 10 GB in a day or has less than 10 percent free. Without it, the warning appears only on the icon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica quando il disco cresce di 10 GB in un giorno o scende sotto il 10 % libero. Senza, l’avviso compare solo sull’icona."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщає, коли диск зростає на 10 ГБ за добу або вільно менше ніж 10 % місця. Без цього попередження з’являється лише на піктограмі."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомляет, когда диск вырастает на 10 ГБ за день или свободно меньше 10 %. Без этого предупреждение видно только на значке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifierar när disken växer 10 GB på en dag eller har mindre än 10 % ledigt. Utan det visas varningen bara på ikonen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver besked, når disken vokser 10 GB på én dag, eller når der er under 10 % ledigt. Uden den vises advarslen kun på symbolet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler når disken vokser 10 GB på én dag eller har under 10 % ledig. Uten det vises advarselen bare på symbolet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟一天增加 10 GB，或可用空間少於 10% 時發出通知。沒有它的話，警示只會顯示在圖像上。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica quando o disco cresce 10 GB num dia ou fica com menos de 10 % livre. Sem ela, o aviso aparece só no ícone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘一天增长 10 GB 或可用空间少于 10 % 时发送通知。关闭后，提醒只显示在图标上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクが1日に10 GB増えたとき、または空きが10％未満になったときに通知します。オフの場合、警告はアイコンにだけ表示されます。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní, když disk během dne naroste o 10 GB nebo má volných méně než 10 %. Bez toho se upozornění zobrazí jen na ikoně."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 동안 디스크가 10GB 늘거나 여유 공간이 10퍼센트 미만이 되면 알립니다. 꺼 두면 경고가 아이콘에만 표시됩니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّه عندما ينمو القرص 10 جيجابايت في يوم واحد أو يتبقى أقل من 10% فارغة. بدونه يظهر التنبيه على الأيقونة فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica quan el disc creix 10 GB en un dia o li queda menys del 10 % lliure. Sense això, l’avís apareix només a la icona."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt, wenn die Festplatte an einem Tag um 10 GB wächst oder weniger als 10 % frei sind. Ohne sie erscheint die Warnung nur am Symbol."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποιεί όταν η χρήση του δίσκου αυξάνεται κατά 10 GB σε μία ημέρα ή όταν μένει λιγότερο από 10% ελεύθερο. Χωρίς αυτήν, η προειδοποίηση εμφανίζεται μόνο στο εικονίδιο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoittaa, kun levy kasvaa 10 Gt päivässä tai vapaata on alle 10 %. Ilman sitä varoitus näkyy vain kuvakkeessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifie quand le disque augmente de 10 Go en un jour ou qu’il reste moins de 10 % d’espace libre. Sans notification, l’alerte n’apparaît que sur l’icône."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שולח התראה כשהכונן גדל ב-10 GB ביום אחד או נשאר עם פחות מ-10% פנויים. בלעדיה, ההתראה מופיעה רק בסמל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क एक दिन में 10 GB बढ़ने या 10 % से कम खाली बचने पर सूचित करता है। इसके बिना चेतावनी सिर्फ़ आइकॉन पर दिखती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šalje obavijest kad disk naraste 10 GB u jednom danu ili kad slobodno ostane manje od 10 %. Bez toga se upozorenje pojavljuje samo na ikoni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi notifikasi saat disk bertambah 10 GB dalam sehari atau sisa ruang kosong kurang dari 10 %. Tanpa ini, peringatan hanya muncul di ikon."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi pemberitahuan apabila cakera bertambah 10 GB dalam sehari atau tinggal kurang daripada 10 % bebas. Tanpanya, amaran hanya muncul pada ikon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia, gdy zajęte miejsce rośnie o 10 GB w ciągu dnia lub gdy wolne zostaje mniej niż 10 %. Bez tego ostrzeżenie pojawia się tylko na ikonie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifică atunci când discul crește cu 10 GB într-o zi sau rămâne cu mai puțin de 10% liber. Fără ea, avertizarea apare doar în pictogramă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní, keď disk narastie o 10 GB za deň alebo mu zostane menej ako 10 % voľných. Bez toho sa upozornenie zobrazí iba na ikone."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvesti, ko disk zraste za 10 GB v enem dnevu ali ima manj kot 10 % prostega. Brez tega se opozorilo prikaže samo na ikoni."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk bir günde 10 GB büyüdüğünde veya %10'dan az boş kaldığında bildirir. Bu olmadan uyarı yalnızca simgede görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo khi ổ đĩa tăng 10 GB trong một ngày hoặc còn trống dưới 10 %. Nếu không bật, cảnh báo chỉ hiện ở biểu tượng."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica cuando el disco crece 10 GB en un día o le queda menos del 10 % libre. Sin ella, el aviso aparece solo en el icono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldt het wanneer de schijf 10 GB per dag groeit of minder dan 10% vrij heeft. Zonder dit verschijnt de waarschuwing alleen op het symbool."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนเมื่อดิสก์ใช้พื้นที่เพิ่มขึ้น 10 GB ในหนึ่งวัน หรือเหลือพื้นที่ว่างน้อยกว่า 10 % หากไม่เปิด การแจ้งเตือนจะปรากฏที่ไอคอนเท่านั้น"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesít, ha a lemez egy nap alatt 10 GB-tal nő, vagy 10 százaléknál kevesebb marad szabadon. Nélküle a figyelmeztetés csak az ikonon jelenik meg."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica cuando el disco crece 10 GB en un día o le queda menos del 10 % libre. Sin ella, el aviso aparece solo en el ícono."
          }
        }
      }
    },
