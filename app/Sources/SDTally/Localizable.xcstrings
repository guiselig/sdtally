    "O sdtally só percorre o volume Data, então só o Lixo da sua conta nele é medido." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally only walks the Data volume, so only your account's Trash on it is measured."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally percorre solo il volume Data, quindi viene misurato solo il Cestino del tuo account su di esso."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally обходить лише том Data, тому вимірюється лише Кошик вашого облікового запису на ньому."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally обходит только том Data, поэтому измеряется лишь Корзина вашей учётной записи на нём."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally går bara igenom Data-volymen, så bara papperskorgen för ditt konto där mäts."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally gennemgår kun diskenheden Data, så kun papirkurven for din konto på den måles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally går bare gjennom Data-volumet, så bare papirkurven til kontoen din der blir målt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally 只走訪資料卷宗，因此只會測量其中屬於你帳號的垃圾桶。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sdtally só percorre o volume Data, por isso só o Lixo da sua conta nele é medido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally 只遍历 Data 宗卷，因此只测量其中你账户的废纸篓。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtallyが走査するのはDataボリュームだけなので、そこにあるこのアカウントのゴミ箱のみ測定します。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally prochází jen svazek Data, takže se měří jen Koš vašeho účtu na něm."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally는 Data 볼륨만 탐색하므로 그 안에 있는 사용자 계정의 휴지통만 측정합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجتاز sdtally وحدة التخزين Data فقط، لذا تُقاس فيها سلة مهملات حسابك فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’sdtally només recorre el volum Data, així que només es mesura la paperera del teu compte en aquest volum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally durchläuft nur das Data-Volume, daher wird nur dein Papierkorb darauf gemessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το sdtally διατρέχει μόνο τον τόμο Data, οπότε μετριέται μόνο ο Κάδος απορριμμάτων του λογαριασμού σας σε αυτόν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally käy läpi vain Data-taltion, joten vain oman tilisi roskakori siinä mitataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally ne parcourt que le volume Data ; seule la Corbeille de votre compte sur ce volume est mesurée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally עובר רק על כרך Data, ולכן נמדדת רק האשפה של החשבון שלך בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally सिर्फ़ Data वॉल्यूम को खंगालता है, इसलिए उसमें सिर्फ़ आपके खाते का ट्रैश मापा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally obilazi samo jedinicu Data, pa se mjeri samo Smeće vašeg računa na njoj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally hanya menelusuri volume Data, jadi hanya Sampah akun Anda di sana yang diukur."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally hanya menjelajah volum Data, jadi hanya Tong Sampah akaun anda di dalamnya yang diukur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally przechodzi tylko przez wolumin Data, więc mierzony jest tylko Kosz Twojego konta na nim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally parcurge doar volumul Data, deci se măsoară doar Coșul de gunoi al contului dvs. de pe el."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally prechádza iba zväzok Data, takže sa meria iba Kôš vášho účtu na ňom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally pregleda samo nosilec Data, zato je izmerjen le koš vašega računa na njem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally yalnızca Data birimini tarar, bu yüzden yalnızca hesabınızın o birimdeki Çöp Sepeti ölçülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally chỉ duyệt volume Data, nên chỉ đo Thùng rác của tài khoản bạn trên đó."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally solo recorre el volumen Data, así que solo se mide la Papelera de tu cuenta en él."
          }
        },
        "nl" : {
          "stringUnit" : {
