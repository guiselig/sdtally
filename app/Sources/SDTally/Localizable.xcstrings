          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es perd res: es regenera o és descartable."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts geht verloren: wird neu erstellt oder ist entbehrlich."
          }
