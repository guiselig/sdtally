          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाई गई फ़ाइलें जिन्हें कोई प्रोसेस अब भी पकड़े हुए है। सबसे बड़ी 10; प्रोसेस बंद होने पर जगह वापस मिलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrisane datoteke koje proces još drži. 10 najvećih; prostor se vraća kad se proces zatvori."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang sudah dihapus tetapi masih dipegang suatu proses. 10 terbesar; ruangnya kembali saat proses ditutup."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fail yang dipadam tetapi masih dipegang oleh proses. 10 terbesar; ruang kembali apabila proses ditutup."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte pliki, które proces wciąż przetrzymuje. 10 największych; miejsce wraca po zamknięciu procesu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișiere șterse pe care un proces încă le ține. Primele 10 ca mărime; spațiul revine când procesul se închide."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbory, ktoré boli odstránené, ale proces ich ešte drží. 10 najväčších; miesto sa uvoľní, keď proces skončí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrisane datoteke, ki jih proces še drži. Največjih 10; prostor se vrne, ko se proces zapre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir işlemin hâlâ tuttuğu silinmiş dosyalar. En büyük 10; işlem kapanınca alan geri döner."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp đã xóa mà một tiến trình vẫn đang giữ. 10 tệp lớn nhất; dung lượng được trả lại khi tiến trình đóng."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos eliminados que un proceso aún retiene. Los 10 más grandes; el espacio se recupera cuando el proceso se cierra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde bestanden die een proces nog openhoudt. De 10 grootste; de ruimte komt vrij zodra het proces stopt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่ลบแล้วแต่โปรเซสยังถืออยู่ แสดง 10 อันดับที่ใหญ่ที่สุด พื้นที่จะคืนเมื่อโปรเซสปิด"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törölt fájlok, amelyeket egy folyamat még tart. A 10 legnagyobb; a hely akkor szabadul fel, amikor a folyamat bezárul."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos eliminados que un proceso aún retiene. Los 10 más grandes; el espacio se recupera cuando el proceso se cierra."
          }
        }
      }
    },
