          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp biểu tượng trên thanh menu sẵn sàng sau khi bật Mac, không cần mở cửa sổ. Hiện trong Mục đăng nhập."
          }
        },
        "es" : {
          "stringUnit" : {
