    "Dados reais ou do sistema: apagar faz falta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real or system data: deleting causes problems."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati reali o di sistema: eliminarli può causare problemi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справжні або системні дані: видалення завдасть шкоди."
          }
        },
        "ru" : {
          "stringUnit" : {
