    "Divide o número do Ajustes em partes com nome." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaks the System Settings number into named parts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide il numero di Impostazioni di Sistema in parti con un nome."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ділить число з Параметрів системи на частини з назвами."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разбивает число из Настроек на именованные части."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delar upp talet från Systeminställningar i delar med namn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler tallet fra Systemindstillinger op i dele med navne."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler tallet fra Systeminnstillinger opp i deler med navn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把系統設定的數字拆成有名稱的部分。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide o número das Definições do Sistema em partes com nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把系统设置中的数字拆分成有名称的部分。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定の数値を、名前の付いた部分に分けます。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělí číslo z Nastavení systému na pojmenované části."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정의 수치를 이름 있는 부분으로 나눕니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقسّم رقم إعدادات النظام إلى أجزاء لها أسماء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divideix el nombre de Configuració del Sistema en parts amb nom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt die Zahl der Systemeinstellungen in benannte Teile auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίζει τον αριθμό των Ρυθμίσεων συστήματος σε μέρη με όνομα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakaa Järjestelmäasetusten luvun nimettyihin osiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répartit le nombre des Réglages Système en parties nommées."
          }
        },
        "he" : {
          "stringUnit" : {
