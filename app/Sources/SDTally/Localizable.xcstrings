    "O diskutil só dá o total de cada volume, e o sdtally só percorre o volume Data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diskutil only gives each volume's total, and sdtally only walks the Data volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diskutil dà solo il totale di ogni volume, e sdtally percorre solo il volume Data."
