          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält das Symbol der Menüleiste nach dem Einschalten des Mac bereit, ohne das Fenster zu öffnen. Erscheint unter Anmeldeobjekte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχει έτοιμο το εικονίδιο στη γραμμή μενού μετά την εκκίνηση του Mac, χωρίς να ανοίξει το παράθυρο. Εμφανίζεται στα Στοιχεία εισόδου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitää valikkorivin kuvakkeen valmiina Macin käynnistyksen jälkeen avaamatta ikkunaa. Näkyy kohdassa Kirjautumiskohteet."
          }
        },
        "fr" : {
          "stringUnit" : {
