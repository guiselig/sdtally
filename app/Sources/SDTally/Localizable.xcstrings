    "Não apague com o iCloud sincronizando; em geral, deixe como está." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't delete while iCloud is syncing; in general, leave it as is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non eliminarla mentre iCloud sincronizza; in generale, lasciala com’è."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не видаляйте, поки iCloud синхронізується; зазвичай залиште як є."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаляйте во время синхронизации iCloud; как правило, оставьте как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera inte medan iCloud synkroniserar; låt det som regel vara."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet den ikke, mens iCloud synkroniserer; lad den som regel være."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke slett mens iCloud synkroniserer; la det vanligvis stå som det er."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步時請勿刪除；一般情況下，維持現狀即可。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não elimine enquanto o iCloud estiver a sincronizar; em geral, deixe como está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 正在同步时不要删除；一般保持原样即可。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudの同期中は削除しないでください。通常はそのままにしておきます。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemažte, dokud iCloud synchronizuje; obecně to nechte být."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud가 동기화 중일 때는 삭제하지 마세요. 대체로 그대로 두는 것이 좋습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحذفها أثناء مزامنة iCloud؛ والأفضل عمومًا تركها كما هي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No l’eliminis mentre iCloud estigui sincronitzant; en general, deixa-ho com està."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht löschen, solange iCloud synchronisiert; lass ihn im Allgemeinen, wie er ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη διαγράψετε ενώ το iCloud συγχρονίζεται· γενικά, αφήστε το ως έχει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä poista iCloudin synkronoidessa; yleensä jätä ennalleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne le supprimez pas pendant qu’iCloud se synchronise ; en général, laissez-le tel quel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אל תמחק בזמן ש-iCloud מסנכרן; ככלל, השאר כמו שהוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud के सिंक होते समय न हटाएँ; आम तौर पर जैसा है वैसा रहने दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne brišite dok se iCloud sinkronizira; općenito, ostavite kako jest."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan hapus saat iCloud sedang menyinkronkan; umumnya biarkan apa adanya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan padam semasa iCloud sedang disegerakkan; secara umum, biarkan sahaja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie usuwaj podczas synchronizacji iCloud; zwykle zostaw bez zmian."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ștergeți cât timp iCloud sincronizează; în general, lăsați cum este."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemažte, kým sa iCloud synchronizuje; vo všeobecnosti ponechajte tak, ako je."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne brišite, medtem ko se iCloud sinhronizira; običajno pustite, kot je."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud eşitlenirken silmeyin; genelde olduğu gibi bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng xóa khi iCloud đang đồng bộ; nhìn chung, cứ để nguyên."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo elimines mientras iCloud sincroniza; en general, déjalo como está."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet verwijderen terwijl iCloud synchroniseert; laat het meestal staan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าลบขณะ iCloud กำลังซิงค์ โดยทั่วไปให้ปล่อยไว้ตามเดิม"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne törölje, amíg az iCloud szinkronizál; általában hagyja úgy, ahogy van."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo elimines mientras iCloud sincroniza; en general, déjalo como está."
