    "Os modelos ficam no volume de dados e entram em Dados do Sistema. Não some com o resto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The models are stored on the Data volume and count toward System Data. Don't add them to the rest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli si trovano nel volume dati e rientrano in Dati sistema. Non sommarli al resto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моделі зберігаються на томі даних і входять до Системних даних. Не додавайте їх до решти."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели хранятся на томе данных и входят в «Системные данные». Не суммируйте их с остальным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellerna ligger på datavolymen och ingår i Systemdata. Lägg inte ihop dem med resten."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellerne ligger på datadiskenheden og indgår i Systemdata. Læg dem ikke sammen med resten."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellene ligger på datavolumet og hører til Systemdata. Ikke legg dem sammen med resten."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型存放在資料卷宗，計入系統資料。請勿與其他項目相加。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos ficam no volume de dados e entram em Dados do sistema. Não os some com o resto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型存放在数据宗卷中，计入系统数据。请勿与其他项目相加。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはデータボリュームに置かれ、システムデータに含まれます。ほかの合計には加えないでください。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modely jsou na datovém svazku a počítají se do Systémových dat. Nesčítat se zbytkem."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델은 데이터 볼륨에 있으며 시스템 데이터에 포함됩니다. 나머지와 합산하지 마세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد النماذج في وحدة تخزين البيانات وتُحتسب ضمن بيانات النظام. لا تجمعها مع الباقي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els models són al volum de dades i entren a Dades del sistema. No ho sumis amb la resta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
