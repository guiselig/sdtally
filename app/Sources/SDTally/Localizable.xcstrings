    "Nada se perde: regenera ou é descartável." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is lost: it regenerates or is disposable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si perde nulla: si rigenera o è eliminabile."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого не втрачається: відновлюється або одноразове."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не теряется: восстановится или одноразовое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget går förlorat: det återskapas eller kan kasseras."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet går tabt: det genskabes eller kan kasseres."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting går tapt: det gjenskapes eller kan kastes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會有損失：可重新產生，或可以捨棄。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se perde: regenera-se ou é descartável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会丢失任何东西：会自动重新生成，或可以丢弃。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失われるものはありません。再生成されるか、不要なものです。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic se neztratí: obnoví se nebo je to zbytečné."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잃는 것 없음: 다시 만들어지거나 버려도 되는 항목입니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
