        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils font partie de Données système et macOS en gère la taille. Ne supprimez pas le dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נמצאים בתוך נתוני המערכת ו-macOS מנהל את הגודל. אל תמחק את התיקייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये सिस्टम डेटा के अंदर रहते हैं और आकार macOS संभालता है। फ़ोल्डर न हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaze se unutar Podataka sustava, a veličinom upravlja macOS. Ne brišite mapu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berada di dalam Data Sistem dan ukurannya dikelola macOS. Jangan hapus foldernya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berada dalam Data Sistem dan macOS mengurus saiznya. Jangan padam folder ini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Są w pozycji Dane systemowe, a rozmiarem zarządza macOS. Nie usuwaj folderu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se află în Date de sistem, iar macOS gestionează dimensiunea. Nu ștergeți folderul."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sú súčasťou Systémových dát a veľkosť riadi macOS. Priečinok nemažte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So znotraj Sistemskih podatkov, velikost pa upravlja macOS. Mape ne brišite."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Verileri'nin içinde durur ve boyutunu macOS yönetir. Klasörü silmeyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nằm trong Dữ liệu hệ thống và macOS quản lý kích thước. Đừng xóa thư mục."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Están dentro de Datos del sistema y macOS gestiona el tamaño. No elimines la carpeta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zitten in Systeemgegevens en macOS beheert de grootte. Verwijder de map niet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยู่ในข้อมูลระบบ และ macOS จัดการขนาดเอง อย่าลบโฟลเดอร์นี้"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rendszeradatokban vannak, a méretüket a macOS kezeli. Ne törölje a mappát."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Están dentro de Datos del sistema y macOS administra el tamaño. No elimines la carpeta."
          }
        }
      }
    },
