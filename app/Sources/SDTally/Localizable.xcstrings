    "Viria de comparar cada snapshot com o disco; hoje só se mede quanto ele segura." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It would come from comparing each snapshot with the disk; today only how much it holds is measured."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si otterrebbe confrontando ogni snapshot con il disco; oggi si misura solo quanto occupa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його можна було б отримати, порівнявши кожен знімок із диском; зараз вимірюється лише те, скільки він утримує."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получилось бы сравнением каждого снимка с диском; сейчас измеряется только, сколько он удерживает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skulle komma från en jämförelse mellan varje ögonblicksbild och disken; i dag mäts bara hur mycket den håller kvar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ville kræve en sammenligning af hvert snapshot med disken; i dag måles kun, hvor meget det holder fast i."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville kommet fra å sammenligne hvert øyeblikksbilde med disken; nå måles bare hvor mye det holder på."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要把每個快照與磁碟比對；目前只測量它佔用多少。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viria de comparar cada instantâneo com o disco; hoje só se mede quanto ele retém."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要把每个快照与磁盘对比才能得到；目前只测量它占用的空间。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各スナップショットをディスクと比較すれば分かりますが、現在は保持している容量だけを測定します。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistilo by se porovnáním každého snímku s diskem; dnes se měří jen to, kolik drží."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 스냅샷을 디스크와 비교해야 알 수 있으며, 지금은 스냅샷이 붙잡고 있는 양만 측정합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب مقارنة كل لقطة بالقرص؛ أما الآن فيُقاس فقط ما تحتفظ به."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiria de comparar cada instantània amb el disc; ara només es mesura quant en reté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käme aus dem Vergleich jedes Snapshots mit der Festplatte; heute wird nur gemessen, wie viel er festhält."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα προέκυπτε από τη σύγκριση κάθε στιγμιότυπου με τον δίσκο· σήμερα μετριέται μόνο πόσα κρατά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saataisiin vertaamalla jokaista tilannevedosta levyyn; nyt mitataan vain, kuinka paljon se pitää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faudrait comparer chaque instantané au disque ; aujourd’hui, on mesure seulement l’espace qu’il retient."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייגזר מהשוואת כל snapshot לכונן; כיום נמדד רק כמה הוא מחזיק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके लिए हर स्नैपशॉट की डिस्क से तुलना करनी होगी; अभी सिर्फ़ यह मापा जाता है कि वह कितनी जगह रोकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobivao bi se usporedbom svake snimke stanja s diskom; danas se mjeri samo koliko prostora drži."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan didapat dengan membandingkan tiap snapshot dengan disk; saat ini hanya diukur berapa yang ditahannya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan datang daripada membandingkan setiap snapshot dengan cakera; buat masa ini hanya jumlah yang dipegangnya diukur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynikałaby z porównania każdej migawki z dyskiem; obecnie mierzy się tylko, ile miejsca zajmuje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar rezulta din compararea fiecărui snapshot cu discul; acum se măsoară doar cât ține fiecare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Získal by sa porovnaním každej snímky s diskom; dnes sa meria iba to, koľko miesta drží."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobili bi jo s primerjavo posameznega posnetka z diskom; zdaj se meri samo, koliko prostora zaseda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her anlık görüntünün diskle karşılaştırılmasından gelirdi; şimdilik yalnızca ne kadar tuttuğu ölçülüyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẽ lấy bằng cách so sánh từng snapshot với ổ đĩa; hiện chỉ đo được lượng mà nó giữ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
