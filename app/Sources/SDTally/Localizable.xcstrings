    "Não mexer: é do sistema; o macOS precisa dessas pastas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave alone: it belongs to the system; macOS needs these folders."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non toccare: sono del sistema; macOS ha bisogno di queste cartelle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не чіпайте: це системне; macOS потрібні ці папки."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не трогать: это система, macOS нужны эти папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rör inte: de tillhör systemet; macOS behöver de här mapparna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad være med at røre dem: de hører til systemet, og macOS har brug for dem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke rør: dette hører til systemet, og macOS trenger disse mappene."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請勿動它：這屬於系統，macOS 需要這些檔案夾。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não mexer: é do sistema; o macOS precisa destas pastas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要动：它们属于系统，macOS 需要这些文件夹。"
