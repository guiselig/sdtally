    "Depende do estado na hora; confira antes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depends on the current state; check first."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipende dallo stato del momento; controlla prima."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залежить від поточного стану; перевірте спершу."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зависит от состояния в данный момент; проверьте заранее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beror på läget just då; kontrollera först."
          }
        },
