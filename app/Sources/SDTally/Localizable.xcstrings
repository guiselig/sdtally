            "value" : "sdtally doorloopt alleen het Data-volume, dus alleen de Prullenmand van je eigen account daarop wordt gemeten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sdtally ไล่ดูเฉพาะวอลุ่มข้อมูล จึงวัดเฉพาะถังขยะของบัญชีคุณในวอลุ่มนั้น"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az sdtally csak a Data kötetet járja be, ezért csak az itteni fiók Kukája mérhető."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
