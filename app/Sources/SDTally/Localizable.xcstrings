    "Cópia da memória que o Mac guarda para acordar; o macOS controla o tamanho." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy of the memory the Mac keeps to wake up; macOS controls the size."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia della memoria che il Mac conserva per riattivarsi; macOS ne controlla la dimensione."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копія пам’яті, яку Mac зберігає для виходу зі сну; розмір контролює macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия памяти, которую Mac хранит для выхода из сна; размером управляет macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia av minnet som Mac sparar för att vakna; macOS styr storleken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopi af hukommelsen, som Mac'en gemmer for at kunne vågne; macOS styrer størrelsen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopi av minnet som Mac-en lagrer for å våkne; macOS styrer størrelsen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 為了喚醒而保存的記憶體副本；大小由 macOS 控制。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópia da memória que o Mac guarda para sair do repouso; o macOS controla o tamanho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 为唤醒而保存的内存副本；大小由 macOS 控制。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macがスリープ解除のために保存するメモリのコピーです。サイズはmacOSが管理します。"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie paměti, kterou Mac uchovává pro probuzení; velikost řídí macOS."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 깨어나기 위해 저장하는 메모리 사본이며, 크기는 macOS가 관리합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخة من الذاكرة يحتفظ بها Mac ليستيقظ من السكون؛ ويتحكم macOS في حجمها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
